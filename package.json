{
  "name": "binary-living-matrix",
  "version": "1.0.0",
  "description": "An interactive binary glyph field",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint src tests scripts *.config.*",
    "test:browser": "playwright test",
    "record": "node scripts/record-demo.mjs"
  },
  "license": "MPL-2.0",
  "type": "module",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8"
  },
  "private": true
}
